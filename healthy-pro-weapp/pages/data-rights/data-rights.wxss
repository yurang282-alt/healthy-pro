.data-rights-page {
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.page-lead {
  max-width: 650rpx;
  margin-top: 14rpx;
  color: #667085;
  font-size: 27rpx;
  line-height: 1.55;
}

.privacy-summary {
  margin-top: 28rpx;
}

.privacy-summary.deletion-state {
  box-shadow: inset 6rpx 0 0 #f59e0b;
}

.privacy-status-note {
  display: block;
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 25rpx;
  line-height: 1.5;
}

.privacy-metrics {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 24rpx;
}

.privacy-metrics view {
  min-width: 0;
  padding: 16rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.16);
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.07);
}

.privacy-metrics text {
  display: block;
  color: rgba(255, 255, 255, 0.68);
  font-size: 22rpx;
}

.privacy-metrics text:first-child {
  margin-bottom: 6rpx;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 900;
}

.privacy-section {
  margin-top: 34rpx;
}

.section-label {
  margin-bottom: 16rpx;
  color: #111827;
  font-size: 30rpx;
  font-weight: 900;
}

.privacy-list {
  border-top: 1rpx solid #dfe5eb;
}

.privacy-list view {
  display: grid;
  grid-template-columns: 160rpx minmax(0, 1fr);
  gap: 18rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #dfe5eb;
}

.privacy-list text:first-child,
.action-copy text:first-child {
  color: #111827;
  font-size: 27rpx;
  font-weight: 900;
}

.privacy-list text:last-child,
.action-copy text:last-child,
.privacy-boundary > text {
  color: #667085;
  font-size: 26rpx;
  line-height: 1.55;
}

.privacy-boundary {
  padding: 22rpx;
  border-left: 6rpx solid #157a55;
  border-radius: 12rpx;
  background: #eef8f2;
}

.privacy-boundary > text {
  display: block;
  color: #365b4d;
}

.privacy-boundary > text + text {
  margin-top: 14rpx;
}

.privacy-link {
  width: auto;
  min-height: 88rpx;
  margin: 18rpx 0 0;
  padding: 0;
  color: #157a55;
  background: transparent;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 88rpx;
  text-align: left;
}

.data-actions {
  padding-top: 26rpx;
  border-top: 1rpx solid #dfe5eb;
}

.action-copy text {
  display: block;
}

.action-copy text:last-child {
  margin-top: 6rpx;
}

.danger-divider {
  height: 1rpx;
  margin: 30rpx 0 24rpx;
  background: #dfe5eb;
}

.danger-button {
  width: 100%;
  min-height: 88rpx;
  margin-top: 18rpx;
  border: 1rpx solid #f1b8b3;
  border-radius: 14rpx;
  color: #b42318;
  background: #fff5f4;
  font-size: 27rpx;
  font-weight: 900;
  line-height: 88rpx;
}
